#include <windows.h>

#define IDC_STATIC -1

#include "resource.h"

IDD_PROFILE_DIALOG DIALOG 0, 0, 260, 240
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT | DS_MODALFRAME
CAPTION "Connection Properties"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Name:", IDC_STATIC, 10, 12, 40, 8
    EDITTEXT IDC_PROFILE_NAME, 55, 10, 195, 14, ES_AUTOHSCROLL
    LTEXT "&Host:", IDC_STATIC, 10, 32, 40, 8
    EDITTEXT IDC_PROFILE_HOST, 55, 30, 195, 14, ES_AUTOHSCROLL
    LTEXT "&Port:", IDC_STATIC, 10, 52, 40, 8
    EDITTEXT IDC_PROFILE_PORT, 55, 50, 60, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "&Domain:", IDC_STATIC, 10, 72, 40, 8
    EDITTEXT IDC_PROFILE_DOMAIN, 55, 70, 195, 14, ES_AUTOHSCROLL
    LTEXT "&Username:", IDC_STATIC, 10, 92, 40, 8
    EDITTEXT IDC_PROFILE_USERNAME, 55, 90, 195, 14, ES_AUTOHSCROLL
    LTEXT "Pass&word:", IDC_STATIC, 10, 112, 40, 8
    EDITTEXT IDC_PROFILE_PASSWORD, 55, 110, 195, 14, ES_AUTOHSCROLL | ES_PASSWORD
    AUTOCHECKBOX "Enable clipboard", IDC_PROFILE_CLIPBOARD, 10, 138, 120, 10
    AUTOCHECKBOX "Ignore certificate errors", IDC_PROFILE_IGNORE_CERT, 10, 154, 140, 10
    AUTOCHECKBOX "Open in full screen", IDC_PROFILE_FULLSCREEN, 10, 170, 140, 10
    DEFPUSHBUTTON "OK", IDOK, 105, 210, 70, 20
    PUSHBUTTON "Cancel", IDCANCEL, 180, 210, 70, 20
END

IDD_CONNECTION_DIALOG DIALOG 0, 0, 380, 280
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT | DS_MODALFRAME
CAPTION "Connections"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT IDC_CONNECTION_SEARCH, 10, 10, 360, 14, ES_AUTOHSCROLL
    CONTROL "", IDC_CONNECTION_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 30, 360, 210
    PUSHBUTTON "&New...", IDC_CONNECTION_NEW, 10, 250, 60, 22
    PUSHBUTTON "&Edit...", IDC_CONNECTION_EDIT, 75, 250, 55, 22
    PUSHBUTTON "&Duplicate", IDC_CONNECTION_DUPLICATE, 135, 250, 65, 22
    PUSHBUTTON "&Delete", IDC_CONNECTION_DELETE, 205, 250, 55, 22
    DEFPUSHBUTTON "Connect", IDC_CONNECTION_CONNECT, 300, 250, 70, 22
END

IDD_ABOUT_DIALOG DIALOG 0, 0, 280, 90
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT | DS_MODALFRAME
CAPTION "About RdpBox"
FONT 9, "Segoe UI"
BEGIN
    ICON IDI_APP_ICON, IDC_ABOUT_ICON, 10, 8, 40, 40
    LTEXT "RdpBox", IDC_ABOUT_TITLE, 56, 10, 214, 12
    LTEXT "Released", IDC_ABOUT_RELEASED_LABEL, 56, 28, 44, 8
    LTEXT "", IDC_ABOUT_RELEASED_VALUE, 102, 28, 168, 8
    LTEXT "GitHub", IDC_ABOUT_REPO_LABEL, 56, 42, 44, 8
    LTEXT "", IDC_ABOUT_REPO_VALUE, 102, 42, 168, 10, SS_NOTIFY
    DEFPUSHBUTTON "OK", IDOK, 200, 64, 70, 20
END
