#include <windows.h>

#define IDC_STATIC -1

#include "resource.h"

IDD_PROFILE_DIALOG DIALOG 0, 0, 260, 200
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT | DS_MODALFRAME
CAPTION "Connection Properties"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Name:", IDC_STATIC, 10, 12, 40, 8
    EDITTEXT IDC_PROFILE_NAME, 55, 10, 195, 14, ES_AUTOHSCROLL
    LTEXT "&Host:", IDC_STATIC, 10, 32, 40, 8
    EDITTEXT IDC_PROFILE_HOST, 55, 30, 195, 14, ES_AUTOHSCROLL
    LTEXT "&Port:", IDC_STATIC, 10, 52, 40, 8
    EDITTEXT IDC_PROFILE_PORT, 55, 50, 60, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "&Username:", IDC_STATIC, 10, 72, 40, 8
    EDITTEXT IDC_PROFILE_USERNAME, 55, 70, 195, 14, ES_AUTOHSCROLL
    LTEXT "&Password:", IDC_STATIC, 10, 92, 40, 8
    EDITTEXT IDC_PROFILE_PASSWORD, 55, 90, 195, 14, ES_AUTOHSCROLL | ES_PASSWORD
    AUTOCHECKBOX "Enable clipboard", IDC_PROFILE_CLIPBOARD, 10, 115, 120, 10
    AUTOCHECKBOX "Ignore certificate errors", IDC_PROFILE_IGNORE_CERT, 10, 130, 140, 10
    DEFPUSHBUTTON "OK", IDOK, 105, 170, 70, 20
    PUSHBUTTON "Cancel", IDCANCEL, 180, 170, 70, 20
END

IDD_CONNECTION_DIALOG DIALOG 0, 0, 380, 300
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT | DS_MODALFRAME
CAPTION "Connections"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT IDC_CONNECTION_SEARCH, 10, 10, 360, 14, ES_AUTOHSCROLL
    CONTROL "", IDC_CONNECTION_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 30, 360, 215
    PUSHBUTTON "&New...", IDC_CONNECTION_NEW, 120, 255, 60, 22
    PUSHBUTTON "&Edit...", IDC_CONNECTION_EDIT, 185, 255, 60, 22
    PUSHBUTTON "&Duplicate", IDC_CONNECTION_DUPLICATE, 250, 255, 60, 22
    PUSHBUTTON "&Delete", IDC_CONNECTION_DELETE, 315, 255, 55, 22
    DEFPUSHBUTTON "Connect", IDC_CONNECTION_CONNECT, 250, 280, 120, 22
END
