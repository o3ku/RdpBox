{
  "version": 4,
  "configurePresets": [
    {
      "name": "msvc-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "D:/local/vcpkg-latest/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "RDPBOX_BUILD_LEGACY": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "msvc-debug",
      "inherits": "msvc-base",
      "binaryDir": "${sourceDir}/build/msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "msvc-release",
      "inherits": "msvc-base",
      "binaryDir": "${sourceDir}/build/msvc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "msvc-debug-test",
      "inherits": "msvc-base",
      "binaryDir": "${sourceDir}/build/msvc-debug-test",
      "cacheVariables": {
        "BUILD_TEST": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "msvc-release-qt",
      "inherits": "msvc-base",
      "binaryDir": "${sourceDir}/build/msvc-release-qt",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RDPBOX_BUILD_QT": "ON",
        "RDPBOX_BUILD_LEGACY": "OFF"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RDPBOX_BUILD_QT": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-release",
      "inherits": "linux-base"
    },
    {
      "name": "macos-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RDPBOX_BUILD_QT": "ON",
        "CMAKE_PREFIX_PATH": "${env:HOMEBREW_PREFIX}/opt/qt@5",
        "OPENSSL_ROOT_DIR": "${env:HOMEBREW_PREFIX}/opt/openssl@3"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-release",
      "inherits": "macos-base"
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release"
    },
    {
      "name": "msvc-debug-test",
      "configurePreset": "msvc-debug-test"
    },
    {
      "name": "msvc-release-qt",
      "configurePreset": "msvc-release-qt"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release"
    }
  ],
  "testPresets": [
    {
      "name": "msvc-debug-test",
      "configurePreset": "msvc-debug-test",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
